# ─── Vercel / Frontend Environment Configuration ────────────────────────────

# Backend API Base URL (Point to your deployed Firebase / Cloud Run URL)
# Example: https://healthsaathi-backend-xxxxxx.a.run.app/api/v1 or https://ai-copilot-54fa9.web.app/api/v1
VITE_API_BASE_URL=https://your-backend-firebase.web.app/api/v1

# Direct AI fallback (optional)
VITE_GROQ_API_KEY=gsk_your_groq_api_key
VITE_GROQ_MODEL=openai/gpt-oss-120b
VITE_ENABLE_MOCK_FALLBACK=false

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=ai-copilot-54fa9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-copilot-54fa9
VITE_FIREBASE_STORAGE_BUCKET=ai-copilot-54fa9.firebasestorage.app
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
