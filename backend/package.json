{
  "name": "healthsaathi-backend",
  "version": "1.0.0",
  "description": "HealthSaathi AI backend — durable health record API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/workers/documentWorker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/documentWorker.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test": "ts-node test/runTests.ts",
    "test:python": "cd ocr && .venv/bin/pytest tests/test_ocr.py -v",
    "test:all": "npm run test:python && npm run test"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "mongodb": "^6.3.0",
    "firebase-admin": "^12.0.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "groq-sdk": "^0.3.3",
    "express-async-errors": "^3.1.1",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "ts-node-dev": "^2.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
