# ─── Server Configuration ──────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
API_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ─── MongoDB Database ───────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_DB_NAME=healthsaathi

# ─── Firebase Admin & Cloud Messaging ───────────────────────────────────────
FIREBASE_PROJECT_ID=ai-copilot-54fa9
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@ai-copilot-54fa9.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
VAPID=your_web_push_vapid_key
STORAGEBUCKET_KEY=ai-copilot-54fa9.firebasestorage.app

# ─── AI Engine (Groq) ───────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key
GROK_MODEL=openai/gpt-oss-120b
GROK_TIMEOUT_MS=30000

# ─── Speech-to-Text (Groq Whisper) ──────────────────────────────────────────
GROQ_API_KEY_STT=gsk_your_groq_stt_api_key
GROQ_STT_MODEL=whisper-large-v3-turbo

# ─── OCR Engine (Optional / Cloud Run) ───────────────────────────────────────
PYTHON_PATH=/app/ocr/.venv/bin/python3
TESSERACT_CMD=/usr/bin/tesseract
MAX_UPLOAD_BYTES=10485760
